---
layout: layouts/base.njk
title: TB TechBridge Consulting | Practical CRM Systems & Trusted Automation
---

{% set hero = collections.home | findByFileSlug("hero") %}
{% set problem = collections.home | findByFileSlug("problem-pain-point") %}
{% set whatIDo = collections.home | findByFileSlug("what-i-do") %}
{% set showcase = collections.home | findByFileSlug("showcase") %}

{% set whoFor = collections.home | findByFileSlug("who-this-is-for") %}
{% set about = collections.all | findByFileSlug("about") %}
{% set contact = collections.all | findByFileSlug("contact") %}

{% if not whoFor %}
  {% set whoFor = collections.home | findByFileSlug("who-for") %}
{% endif %}

{% if hero %}
  <section class="hero">
    <div class="hero-content">
      {% if hero.data.eyebrow %}
        <p class="eyebrow">{{ hero.data.eyebrow }}</p>
      {% endif %}

      {% if hero.data.headline %}
        <h1 class="hero-title hero-title-desktop">
          {{ hero.data.headline }}
        </h1>
      {% endif %}

      {% if hero.data.mobileHeadline %}
        <h1 class="hero-title hero-title-mobile">
          {{ hero.data.mobileHeadline }}
        </h1>
      {% endif %}

      <div class="hero-lower">
        {% if hero.data.subheadline %}
          <p class="hero-copy">{{ hero.data.subheadline }}</p>
        {% endif %}

        {% if hero.templateContent %}
          <div class="hero-copy">
            {{ hero.templateContent | safe }}
          </div>
        {% endif %}

        <div class="hero-actions">
          {% if hero.data.primaryCtaLabel and hero.data.primaryCtaUrl %}
            <a class="button primary" href="{{ hero.data.primaryCtaUrl }}">
              {{ hero.data.primaryCtaLabel }}
            </a>
          {% else %}
            <a class="button primary" href="#projects">View Systems Built</a>
          {% endif %}

          {% if hero.data.secondaryCtaLabel and hero.data.secondaryCtaUrl %}
            <a class="button secondary" href="{{ hero.data.secondaryCtaUrl }}">
              {{ hero.data.secondaryCtaLabel }}
            </a>
          {% else %}
            <a class="button secondary" href="#contact">Start a Conversation</a>
          {% endif %}
        </div>
      </div>
    </div>

    {% if hero.data.focusAreas %}
      <aside class="hero-card">
        <p class="card-label">Focus Areas</p>
        <ul>
          {% for item in hero.data.focusAreas %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </aside>
    {% endif %}
  </section>
{% endif %}

{% if problem or whatIDo %}
  <section class="section alt home-two-up-section">
    <div class="home-two-up">
      {% if problem %}
        <article id="problem" class="home-two-up-panel">
          <div class="section-heading">
            {% if problem.data.eyebrow %}
              <p class="eyebrow">{{ problem.data.eyebrow }}</p>
            {% endif %}

            {% if problem.data.headline %}
              <h2>{{ problem.data.headline }}</h2>
            {% endif %}
          </div>

          {% if problem.templateContent %}
            <div class="about section-copy">
              {{ problem.templateContent | safe }}
            </div>
          {% endif %}

          {% if problem.data.painPoints %}
            <div class="grid cards compact-cards">
              {% for point in problem.data.painPoints %}
                <article class="card">
                  <p>{{ point }}</p>
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endif %}

      {% if whatIDo %}
        <article id="services" class="home-two-up-panel">
          <div class="section-heading">
            {% if whatIDo.data.eyebrow %}
              <p class="eyebrow">{{ whatIDo.data.eyebrow }}</p>
            {% endif %}

            {% if whatIDo.data.headline %}
              <h2>{{ whatIDo.data.headline }}</h2>
            {% endif %}
          </div>

          {% if whatIDo.templateContent %}
            <div class="about section-copy">
              {{ whatIDo.templateContent | safe }}
            </div>
          {% endif %}

          {% if whatIDo.data.capabilities %}
            <div class="grid cards compact-cards">
              {% for capability in whatIDo.data.capabilities %}
                <article class="card">
                  <h3>{{ capability.title }}</h3>
                  <p>{{ capability.summary }}</p>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="grid cards compact-cards">
              {% for service in collections.services %}
                <article class="card">
                  <h3>{{ service.data.title }}</h3>
                  {{ service.templateContent | safe }}
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endif %}
    </div>
  </section>
{% endif %}

{% if showcase %}
  <section class="showcase-section" id="projects">
    <div class="showcase-section__header">
      {% if showcase.data.eyebrow %}
        <p class="eyebrow">
          {{ showcase.data.eyebrow }}
        </p>
      {% endif %}

      {% if showcase.data.headline %}
        <h2 class="showcase-section__headline">
          {{ showcase.data.headline }}
        </h2>
      {% endif %}

      {% if showcase.data.sectionIntro %}
        <p class="showcase-section__intro">
          {{ showcase.data.sectionIntro }}
        </p>
      {% endif %}
    </div>

    <div class="showcase-stack">

      {# Featured CRM and RevOps systems #}
      {% if showcase.data.featuredSystems %}
        <article class="showcase-card showcase-card--featured">
          <header class="showcase-card__header">
            {% if showcase.data.featuredSystems.title %}
              <p class="showcase-card__eyebrow">
                {{ showcase.data.featuredSystems.title }}
              </p>
            {% endif %}

            {% if showcase.data.featuredSystems.summary %}
              <p class="showcase-card__summary">
                {{ showcase.data.featuredSystems.summary }}
              </p>
            {% endif %}
          </header>

          {% if showcase.data.featuredSystems.systems %}
            <div class="showcase-projects">
              {% for system in showcase.data.featuredSystems.systems %}
                <article class="showcase-project">
                  {% if system.title %}
                    <h3 class="showcase-project__title">
                      {{ system.title }}
                    </h3>
                  {% endif %}

                  {% if system.summary %}
                    <p class="showcase-project__summary">
                      {{ system.summary }}
                    </p>
                  {% endif %}

                  {% if system.url %}
                    <a
                      class="showcase-project__link"
                      href="{{ system.url }}"
                      aria-label="View project: {{ system.title }}"
                    >
                      View project
                      <span aria-hidden="true">→</span>
                    </a>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endif %}

      {# Other systems, collapsed by default #}
      {% if showcase.data.otherSystems %}
        <details class="showcase-card showcase-card--expandable">
          <summary class="showcase-card__toggle">
            <span class="showcase-card__toggle-copy">
              {% if showcase.data.otherSystems.title %}
                <span class="showcase-card__eyebrow">
                  {{ showcase.data.otherSystems.title }}
                </span>
              {% endif %}

              {% if showcase.data.otherSystems.summary %}
                <span class="showcase-card__summary">
                  {{ showcase.data.otherSystems.summary }}
                </span>
              {% endif %}
            </span>

            <span
              class="showcase-card__toggle-icon"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          {% if showcase.data.otherSystems.systems %}
            <div class="showcase-card__expanded-content">
              <div class="showcase-projects">
                {% for system in showcase.data.otherSystems.systems %}
                  <article class="showcase-project">
                    {% if system.title %}
                      <h3 class="showcase-project__title">
                        {{ system.title }}
                      </h3>
                    {% endif %}

                    {% if system.summary %}
                      <p class="showcase-project__summary">
                        {{ system.summary }}
                      </p>
                    {% endif %}

                    {% if system.url %}
                      <a
                        class="showcase-project__link"
                        href="{{ system.url }}"
                        aria-label="View project: {{ system.title }}"
                      >
                        View project
                        <span aria-hidden="true">→</span>
                      </a>
                    {% endif %}
                  </article>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </details>
      {% endif %}

    </div>
  </section>
{% endif %}

{% if whoFor %}
  <section id="who-for" class="section alt">
    <div class="section-heading">
      {% if whoFor.data.eyebrow %}
        <p class="eyebrow">{{ whoFor.data.eyebrow }}</p>
      {% endif %}

      {% if whoFor.data.headline %}
        <h2>{{ whoFor.data.headline }}</h2>
      {% endif %}
    </div>

    {% if whoFor.templateContent %}
      <div class="about">
        {{ whoFor.templateContent | safe }}
      </div>
    {% endif %}

    {% if whoFor.data.audiences %}
      <div class="grid cards">
        {% for audience in whoFor.data.audiences %}
          <article class="card">
            <h3>{{ audience.title }}</h3>
            <p>{{ audience.summary }}</p>

            {% if audience.bestFor %}
              <ul>
                {% for item in audience.bestFor %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endif %}

{% if about %}
  <section id="about" class="section about">
    <div class="section-heading">
      {% if about.data.eyebrow %}
        <p class="eyebrow">{{ about.data.eyebrow }}</p>
      {% endif %}

      {% if about.data.headline %}
        <h2>{{ about.data.headline }}</h2>
      {% endif %}
    </div>

    {{ about.templateContent | safe }}
  </section>
{% endif %}

{% if contact %}
  <section id="contact" class="section contact">
    <div>
      {% if contact.data.eyebrow %}
        <p class="eyebrow">{{ contact.data.eyebrow }}</p>
      {% endif %}

      {% if contact.data.headline %}
        <h2>{{ contact.data.headline }}</h2>
      {% endif %}

      {{ contact.templateContent | safe }}
    </div>

    {% if contact.data.email %}
      <a class="button primary" href="mailto:{{ contact.data.email }}">
        {{ contact.data.email }}
      </a>
    {% endif %}
  </section>
{% endif %}