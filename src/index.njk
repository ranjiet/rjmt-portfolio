---
layout: layouts/base.njk
title: TB TechBridge Consulting | Practical CRM Systems & Trusted Automation
---

{# ==========================================================
   HOME CONTENT
   ========================================================== #}

{% set hero = collections.home | findByFileSlug("hero") %}
{% set problem = collections.home | findByFileSlug("problem-pain-point") %}
{% set guidingPrinciples = collections.home | findByFileSlug("tb-guiding-principles") %}
{% set howWeHelp = collections.home | findByFileSlug("tb-how-we-help") %}
{% set showcase = collections.home | findByFileSlug("showcase") %}
{% set whoFor = collections.home | findByFileSlug("tb-who-for") %}

{# ==========================================================
   PAGE CONTENT
   ========================================================== #}

{% set about = collections.all | findByFileSlug("about") %}
{% set contact = collections.all | findByFileSlug("contact") %}
{% set projectPage = collections.all | findByFileSlug("project") %}


{# ==========================================================
   HERO
   ========================================================== #}

{% if hero %}
  <section class="hero">
    <div class="hero-content">
      {% if hero.data.eyebrow %}
        <p class="eyebrow">
          {{ hero.data.eyebrow }}
        </p>
      {% endif %}

      {% if hero.data.headline %}
        <h1 class="hero-title hero-title-desktop">
          {{ hero.data.headline }}
        </h1>
      {% endif %}

      {% if hero.data.mobileHeadline %}
        <h1 class="hero-title hero-title-mobile">
          {{ hero.data.mobileHeadline }}
        </h1>
      {% endif %}

      <div class="hero-lower">
        {% if hero.data.subheadline %}
          <p class="hero-copy">
            {{ hero.data.subheadline }}
          </p>
        {% endif %}

        {% if hero.templateContent %}
          <div class="hero-copy">
            {{ hero.templateContent | safe }}
          </div>
        {% endif %}

        <div class="hero-actions">
          {% if hero.data.primaryCtaLabel and hero.data.primaryCtaUrl %}
            <a
              class="button primary"
              href="{{ hero.data.primaryCtaUrl }}"
            >
              {{ hero.data.primaryCtaLabel }}
            </a>
          {% else %}
            <a class="button primary" href="#projects">
              View Systems Built
            </a>
          {% endif %}

          {% if hero.data.secondaryCtaLabel and hero.data.secondaryCtaUrl %}
            <a
              class="button secondary"
              href="{{ hero.data.secondaryCtaUrl }}"
            >
              {{ hero.data.secondaryCtaLabel }}
            </a>
          {% else %}
            <a class="button secondary" href="#contact">
              Start a Conversation
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    {% if hero.data.focusAreas %}
      <aside class="hero-card">
        <p class="card-label">
          Focus Areas
        </p>

        <ul>
          {% for item in hero.data.focusAreas %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </aside>
    {% endif %}
  </section>
{% endif %}


{# ==========================================================
   PROBLEM + HOW TECHBRIDGE HELPS
   ========================================================== #}

{% if problem or howWeHelp %}
  <section class="section alt home-two-up-section">
    <div class="home-two-up">

      {% if problem %}
        <article
          id="problem"
          class="home-two-up-panel"
        >
          <div class="section-heading">
            {% if problem.data.eyebrow %}
              <p class="eyebrow">
                {{ problem.data.eyebrow }}
              </p>
            {% endif %}

            {% if problem.data.headline %}
              <h2>
                {{ problem.data.headline }}
              </h2>
            {% endif %}
          </div>

          {% if problem.templateContent %}
            <div class="about section-copy">
              {{ problem.templateContent | safe }}
            </div>
          {% endif %}

          {% if problem.data.painPoints %}
            <div class="grid cards compact-cards">
              {% for point in problem.data.painPoints %}
                <article class="card">
                  <p>{{ point }}</p>
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endif %}


      {% if howWeHelp %}
        <article
          id="how-we-help"
          class="home-two-up-panel"
        >
          {#
            Backward-compatible anchor for any older links
            that still point to #services.
          #}
          <span
            id="services"
            class="section-anchor"
            aria-hidden="true"
          ></span>

          <div class="section-heading">
            {% if howWeHelp.data.eyebrow %}
              <p class="eyebrow">
                {{ howWeHelp.data.eyebrow }}
              </p>
            {% endif %}

            {% if howWeHelp.data.headline %}
              <h2>
                {{ howWeHelp.data.headline }}
              </h2>
            {% endif %}
          </div>

          {% if howWeHelp.templateContent %}
            <div class="about section-copy">
              {{ howWeHelp.templateContent | safe }}
            </div>
          {% endif %}

          {% if howWeHelp.data.capabilities %}
            <div class="grid cards compact-cards">
              {% for capability in howWeHelp.data.capabilities %}
                <article class="card">
                  {% if capability.title %}
                    <h3>
                      {{ capability.title }}
                    </h3>
                  {% endif %}

                  {% if capability.summary %}
                    <p>
                      {{ capability.summary }}
                    </p>
                  {% endif %}
                </article>
              {% endfor %}
            </div>

          {% elif collections.services %}
            <div class="grid cards compact-cards">
              {% for service in collections.services %}
                <article class="card">
                  {% if service.data.title %}
                    <h3>
                      {{ service.data.title }}
                    </h3>
                  {% endif %}

                  {% if service.templateContent %}
                    {{ service.templateContent | safe }}
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endif %}

    </div>
  </section>
{% endif %}


{# ==========================================================
   GUIDING PRINCIPLES
   Formerly how-i-think.md
   ========================================================== #}

{% if guidingPrinciples %}
  <section
    id="guiding-principles"
    class="section guiding-principles-section"
  >
    <div class="section-heading">
      {% if guidingPrinciples.data.eyebrow %}
        <p class="eyebrow">
          {{ guidingPrinciples.data.eyebrow }}
        </p>
      {% endif %}

      {% if guidingPrinciples.data.headline %}
        <h2>
          {{ guidingPrinciples.data.headline }}
        </h2>
      {% endif %}

      {% if guidingPrinciples.data.sectionIntro %}
        <p class="section-intro">
          {{ guidingPrinciples.data.sectionIntro }}
        </p>
      {% endif %}
    </div>

    {% if guidingPrinciples.templateContent %}
      <div class="about section-copy">
        {{ guidingPrinciples.templateContent | safe }}
      </div>
    {% endif %}

    {% if guidingPrinciples.data.principles %}
      <div class="grid cards principles-grid">
        {% for principle in guidingPrinciples.data.principles %}
          <article class="card">
            {% if principle.title %}
              <h3>
                {{ principle.title }}
              </h3>
            {% endif %}

            {% if principle.summary %}
              <p>
                {{ principle.summary }}
              </p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endif %}


{# ==========================================================
   SELECTED WORK
   Driven by content/home/showcase.md
   ========================================================== #}

{% if showcase %}
  {% set projectsUrl = "/projects/" %}
  {% set projectsLabel = "Explore all projects" %}

  {% if projectPage and projectPage.url %}
    {% set projectsUrl = projectPage.url %}
  {% endif %}

  {% if showcase.data.projectsLink %}
    {% if showcase.data.projectsLink.url %}
      {% set projectsUrl = showcase.data.projectsLink.url %}
    {% endif %}

    {% if showcase.data.projectsLink.label %}
      {% set projectsLabel = showcase.data.projectsLink.label %}
    {% endif %}
  {% endif %}

  <section
    class="showcase-section"
    id="projects"
  >
    <div class="showcase-section__header">
      {% if showcase.data.eyebrow %}
        <p class="eyebrow">
          {{ showcase.data.eyebrow }}
        </p>
      {% endif %}

      {% if showcase.data.headline %}
        <h2 class="showcase-section__headline">
          {{ showcase.data.headline }}
        </h2>
      {% endif %}

      {% if showcase.data.sectionIntro %}
        <p class="showcase-section__intro">
          {{ showcase.data.sectionIntro }}
        </p>
      {% endif %}
    </div>


    <div class="showcase-stack">

      {# Featured CRM and RevOps systems #}

      {% if showcase.data.featuredSystems %}
        <article class="showcase-card showcase-card--featured">
          <header class="showcase-card__header">
            {% if showcase.data.featuredSystems.title %}
              <p class="showcase-card__eyebrow">
                {{ showcase.data.featuredSystems.title }}
              </p>
            {% endif %}

            {% if showcase.data.featuredSystems.summary %}
              <p class="showcase-card__summary">
                {{ showcase.data.featuredSystems.summary }}
              </p>
            {% endif %}
          </header>

          {% if showcase.data.featuredSystems.systems %}
            <div class="showcase-projects">
              {% for system in showcase.data.featuredSystems.systems %}
                <article class="showcase-project">
                  {% if system.title %}
                    <h3 class="showcase-project__title">
                      {{ system.title }}
                    </h3>
                  {% endif %}

                  {% if system.summary %}
                    <p class="showcase-project__summary">
                      {{ system.summary }}
                    </p>
                  {% endif %}

                  {% if system.url %}
                    <a
                      class="showcase-project__link"
                      href="{{ system.url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="View project: {{ system.title }} in a new tab"
                    >
                      View project
                      <span aria-hidden="true">→</span>
                    </a>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endif %}

    </div>

    <div class="showcase-section__footer">
      <a
        class="button secondary"
        href="{{ projectsUrl }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ projectsLabel }} in a new tab"
      >
        {{ projectsLabel }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
{% endif %}


{# ==========================================================
   WHO TECHBRIDGE IS FOR
   Formerly who-this-is-for.md
   ========================================================== #}

{% if whoFor %}
  <section
    id="who-for"
    class="section alt"
  >
    <div class="section-heading">
      {% if whoFor.data.eyebrow %}
        <p class="eyebrow">
          {{ whoFor.data.eyebrow }}
        </p>
      {% endif %}

      {% if whoFor.data.headline %}
        <h2>
          {{ whoFor.data.headline }}
        </h2>
      {% endif %}
    </div>

    {% if whoFor.templateContent %}
      <div class="about section-copy">
        {{ whoFor.templateContent | safe }}
      </div>
    {% endif %}

    {% if whoFor.data.audiences %}
      <div class="grid cards">
        {% for audience in whoFor.data.audiences %}
          <article class="card">
            {% if audience.title %}
              <h3>
                {{ audience.title }}
              </h3>
            {% endif %}

            {% if audience.summary %}
              <p>
                {{ audience.summary }}
              </p>
            {% endif %}

            {% if audience.bestFor %}
              <ul>
                {% for item in audience.bestFor %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endif %}


{# ==========================================================
   ABOUT
   ========================================================== #}

{% if about %}
  <section
    id="about"
    class="section about"
  >
    <div class="section-heading">
      {% if about.data.eyebrow %}
        <p class="eyebrow">
          {{ about.data.eyebrow }}
        </p>
      {% endif %}

      {% if about.data.headline %}
        <h2>
          {{ about.data.headline }}
        </h2>
      {% endif %}
    </div>

    {% if about.templateContent %}
      {{ about.templateContent | safe }}
    {% endif %}
  </section>
{% endif %}


{# ==========================================================
   CONTACT
   ========================================================== #}

{% if contact %}
  <section
    id="contact"
    class="section contact"
  >
    <div>
      {% if contact.data.eyebrow %}
        <p class="eyebrow">
          {{ contact.data.eyebrow }}
        </p>
      {% endif %}

      {% if contact.data.headline %}
        <h2>
          {{ contact.data.headline }}
        </h2>
      {% endif %}

      {% if contact.templateContent %}
        {{ contact.templateContent | safe }}
      {% endif %}
    </div>

    {% if contact.data.email %}
      <a
        class="button primary"
        href="mailto:{{ contact.data.email }}"
      >
        {{ contact.data.email }}
      </a>
    {% endif %}
  </section>
{% endif %}