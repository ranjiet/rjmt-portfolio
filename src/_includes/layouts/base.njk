<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>

<body>
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand-mark">TB</span>
      <span class="brand-text">TechBridge Consulting</span>
    </a>

    <nav class="nav" aria-label="Primary navigation">
      <a href="{{ '/#how-we-help' | url }}">Services</a>
      <a href="{{ '/projects/' | url }}">Projects</a>
      <a href="{{ '/#about' | url }}">About</a>
      <a class="nav-cta" href="{{ '/#contact' | url }}">Contact</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>© <span id="year"></span> TechBridge Consulting. Practical systems, human-friendly workflows.</p>
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
  <script src="/assets/js/site.js"></script>
</body>
</html>
